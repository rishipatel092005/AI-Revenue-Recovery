# Copy to .env and fill in. Never commit the filled-in version.

# --- Supabase (required) -----------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Optional payment-link base used by the simulated WhatsApp message.
PAYMENT_LINK_BASE=https://rzp.io/i

# Keep this true for local demos. No real messages or calls are sent.
DRY_RUN=true

# Optional live-channel settings. Leave empty while DRY_RUN=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
VOICE_PROVIDER=bolna
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
